{
  "contract": 1,
  "id": "clock",
  "name": { "en": "Clock" },
  "description": { "en": "The time and date for a time zone" },
  "icon": ["clock-symbolic", "appointment-symbolic", "chronometer-symbolic"],
  "spans": ["1x1"],
  "defaultSpan": "1x1",
  "category": "Info",
  "version": 1,
  "services": ["clock"],
  "settings": [
    { "key": "timezone", "type": "timezone", "label": { "en": "Time zone" }, "default": "local" },
    { "key": "label", "type": "string", "label": { "en": "Label (optional)" }, "default": "" },
    { "key": "timeFormat", "type": "enum", "label": { "en": "Time format" }, "default": "locale", "options": ["locale", "24h", "12h"], "labels": { "locale": { "en": "Follow system" }, "24h": { "en": "24-hour" }, "12h": { "en": "12-hour" } } }
  ]
}
