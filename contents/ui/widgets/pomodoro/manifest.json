{
  "contract": 1,
  "id": "pomodoro",
  "name": { "en": "Pomodoro" },
  "description": { "en": "A focus and break timer that can silence notifications while you work" },
  "icon": ["chronometer-symbolic", "clock-symbolic", "appointment-soon-symbolic"],
  "spans": ["1x1", "2x1", "4x1"],
  "defaultSpan": "1x1",
  "category": "Info",
  "version": 1,
  "services": ["timer"],
  "settings": [
    { "key": "focus", "type": "number", "label": { "en": "Focus" }, "unit": { "en": "min" }, "default": 25, "min": 5, "max": 90, "step": 5 },
    { "key": "break", "type": "number", "label": { "en": "Break" }, "unit": { "en": "min" }, "default": 5, "min": 0, "max": 30, "step": 1 },
    { "key": "longBreak", "type": "number", "label": { "en": "Long break" }, "unit": { "en": "min" }, "zeroLabel": { "en": "None" }, "default": 15, "min": 0, "max": 60, "step": 5 },
    { "key": "rounds", "type": "number", "label": { "en": "Rounds" }, "default": 4, "min": 1, "max": 8, "step": 1 },
    { "key": "dnd", "type": "bool", "label": { "en": "Do Not Disturb during focus" }, "default": true },
    { "key": "summary", "type": "note", "label": { "en": "Summary" } }
  ]
}
